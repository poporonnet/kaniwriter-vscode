{
  "name": "kaniwriter-vscode",
  "displayName": "kaniwriter",
  "publisher": "poporonnet",
  "description": "Open kaniwriter from VSCode",
  "version": "0.3.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poporonnet/kaniwriter-vscode.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kaniwriter-vscode.open-kaniwriter",
        "title": "Open kaniwriter",
        "icon": "$(play-circle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kaniwriter-vscode.open-kaniwriter",
          "group": "navigation",
          "when": "editorLangId == ruby"
        }
      ]
    },
    "configuration": {
      "title": "kaniwriter",
      "properties": {
        "kaniwriter-vscode.compilerInstance": {
          "type": "string",
          "order": 0,
          "enum": [
            "https://ceres.epi.it.matsue-ct.ac.jp/compile",
            "custom"
          ],
          "enumItemLabels": [
            "ceres.epi.it.matsue-ct.ac.jp/compile",
            "Custom"
          ],
          "enumDescriptions": [
            "Use ceres.epi.it.matsue-ct.ac.jp instance",
            "Input custom URL"
          ],
          "description": "kanicc instance to use.",
          "default": "https://ceres.epi.it.matsue-ct.ac.jp/compile"
        },
        "kaniwriter-vscode.customCompilerUrl": {
          "type": "string",
          "order": 1,
          "pattern": "^$|^https?://.+$",
          "patternErrorMessage": "Enter a valid URL or leave empty.",
          "description": "Custom URL for kanicc instance to use."
        },
        "kaniwriter-vscode.writerInstance": {
          "type": "string",
          "order": 0,
          "enum": [
            "https://kaniwriter.poporon.org",
            "https://ceres.epi.it.matsue-ct.ac.jp/writer",
            "custom"
          ],
          "enumItemLabels": [
            "kaniwriter.poporon.org",
            "ceres.epi.it.matsue-ct.ac.jp/writer",
            "Custom"
          ],
          "enumDescriptions": [
            "Use poporon.org instance",
            "Use ceres.epi.it.matsue-ct.ac.jp instance",
            "Input custom URL"
          ],
          "description": "kaniwriter instance to use.",
          "default": "https://kaniwriter.poporon.org"
        },
        "kaniwriter-vscode.customWriterUrl": {
          "type": "string",
          "order": 1,
          "pattern": "^$|^https?://.+$",
          "patternErrorMessage": "Enter a valid URL or leave empty.",
          "description": "Custom URL for kaniwriter instance to use."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run check",
    "check": "biome check --write",
    "test": "vscode-test",
    "package": "vsce package",
    "check:ci": "biome ci && tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mocha": "10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8"
}
